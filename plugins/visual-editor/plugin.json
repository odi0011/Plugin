{
    "slug": "visual-editor",
    "name": "可视化编辑器",
    "version": "1.0.0",
    "author": "odi0011",
    "author_url": "",
    "homepage": "",
    "description": "拖拽式页面搭建器。用「区块 / 栏 / 控件」三层结构化文档描述页面，样式按桌面、平板、手机三个断点分别设置，服务端把结构编译成白名单 CSS 与转义后的 HTML，因此不存在把任意 CSS/JS 存进页面的路径。自带草稿预览、发布撤回、修订回滚，并把建页能力完整开放给公开 API 与 AI Agent。",
    "icon": "icon.svg",
    "screenshots": [],
    "requires": "7i",
    "requires_php": "8.0",
    "license": "MIT",
    "category": "content",
    "tags": ["可视化编辑", "页面搭建", "拖拽", "响应式"],
    "permissions": [
        {"key": "visual_editor.view", "label": "查看可视化文档", "group": "plugin", "sort_order": 1300},
        {"key": "visual_editor.edit", "label": "编辑可视化文档", "group": "plugin", "sort_order": 1310},
        {"key": "visual_editor.publish", "label": "发布/撤回可视化文档", "group": "plugin", "sort_order": 1320},
        {"key": "visual_editor.code", "label": "使用自定义 HTML 控件", "group": "plugin", "sort_order": 1330}
    ],
    "settings": {
        "permission": "visual_editor.edit",
        "title": "可视化编辑器设置",
        "sections": [
            {
                "key": "routing",
                "label": "前台路径",
                "fields": [
                    {
                        "key": "url_prefix",
                        "label": "路径前缀",
                        "type": "text",
                        "default": "",
                        "max_length": 40,
                        "pattern": "^[a-z0-9][a-z0-9-]{0,38}[a-z0-9]?$",
                        "placeholder": "留空 = 挂在站点根下",
                        "help": "留空表示文档直接挂在站点根下（/about）；填 page 则是 /page/about。与核心页面 slug 相同时核心页面优先，不会被抢走。"
                    }
                ]
            },
            {
                "key": "layout",
                "label": "断点与宽度",
                "fields": [
                    {
                        "key": "breakpoint_tablet",
                        "label": "平板断点（px）",
                        "type": "number",
                        "default": 1024,
                        "min": 768,
                        "max": 1600,
                        "help": "视口宽度小于等于该值时套用平板样式。"
                    },
                    {
                        "key": "breakpoint_mobile",
                        "label": "手机断点（px）",
                        "type": "number",
                        "default": 767,
                        "min": 320,
                        "max": 1024,
                        "help": "视口宽度小于等于该值时套用手机样式。必须小于平板断点，否则渲染时按默认值兜底。"
                    },
                    {
                        "key": "container_max",
                        "label": "内容区最大宽度（px）",
                        "type": "number",
                        "default": 1200,
                        "min": 600,
                        "max": 2400,
                        "help": "定宽区块的内容最大宽度；通栏区块不受它约束。"
                    }
                ]
            },
            {
                "key": "history",
                "label": "修订",
                "fields": [
                    {
                        "key": "revision_limit",
                        "label": "每个文档保留的修订数",
                        "type": "number",
                        "default": 20,
                        "min": 3,
                        "max": 100,
                        "help": "每次保存自动写一条修订，超出数量的旧修订会被裁掉。"
                    }
                ]
            }
        ]
    },
    "api": [
        {
            "endpoint": "documents",
            "method": "GET",
            "label": "列出可视化文档",
            "description": "分页列出可视化文档的 id、slug、标题、状态与更新时间。不返回文档树本身（树请用 document 端点取轮廓）。",
            "handler": "VisualEditorApi::listDocuments",
            "permission": "visual_editor.view",
            "params": ["status", "keyword", "page", "per_page"],
            "risk": "low"
        },
        {
            "endpoint": "document",
            "method": "GET",
            "label": "读取一个可视化文档轮廓",
            "description": "按 id 或 slug 返回文档元信息与结构轮廓（区块/栏/控件的 id、类型、文本摘要），用于定位要改的元素 id。",
            "handler": "VisualEditorApi::getDocument",
            "permission": "visual_editor.view",
            "params": ["id", "slug"],
            "risk": "low"
        },
        {
            "endpoint": "create-document",
            "method": "POST",
            "label": "新建可视化文档",
            "description": "创建一个草稿文档。slug 留空则由标题派生；重名会被拒绝。新文档带一个空区块，可继续用 add-widget 填充。",
            "handler": "VisualEditorApi::createDocument",
            "permission": "visual_editor.edit",
            "params": ["title", "slug", "seo_title", "seo_description"],
            "risk": "medium"
        },
        {
            "endpoint": "update-document",
            "method": "POST",
            "label": "修改可视化文档元信息",
            "description": "改标题、slug 与 SEO 字段。不动文档树。lock_version 不匹配时返回 409。",
            "handler": "VisualEditorApi::updateDocument",
            "permission": "visual_editor.edit",
            "params": ["id", "title", "slug", "seo_title", "seo_description", "lock_version"],
            "risk": "medium"
        },
        {
            "endpoint": "add-section",
            "method": "POST",
            "label": "追加一个区块",
            "description": "在文档末尾或指定位置插入一个区块，并按 columns 指定等分栏数（1–4）。返回新区块与新栏的 id。",
            "handler": "VisualEditorApi::addSection",
            "permission": "visual_editor.edit",
            "params": ["id", "columns", "layout", "position", "lock_version"],
            "risk": "medium"
        },
        {
            "endpoint": "add-widget",
            "method": "POST",
            "label": "追加一个控件",
            "description": "往指定栏里追加一个控件（heading/text/image/button/spacer/divider/list/quote/embed）。文本、链接等内容用同名参数传入，服务端按控件白名单校验。",
            "handler": "VisualEditorApi::addWidget",
            "permission": "visual_editor.edit",
            "params": ["id", "column", "type", "text", "url", "level", "align", "src", "alt", "position", "lock_version"],
            "risk": "medium"
        },
        {
            "endpoint": "update-element",
            "method": "POST",
            "label": "修改一个元素的内容",
            "description": "按元素 id 改控件的文本、链接、标题级别、对齐等内容字段。只接受该控件类型声明过的字段，未声明的一律拒绝。",
            "handler": "VisualEditorApi::updateElement",
            "permission": "visual_editor.edit",
            "params": ["id", "element", "text", "url", "level", "align", "src", "alt", "lock_version"],
            "risk": "medium"
        },
        {
            "endpoint": "move-element",
            "method": "POST",
            "label": "移动一个元素",
            "description": "把区块或控件在其同级序列里上移/下移一位（direction 取 up/down）。跨栏移动请用编辑器界面。",
            "handler": "VisualEditorApi::moveElement",
            "permission": "visual_editor.edit",
            "params": ["id", "element", "direction", "lock_version"],
            "risk": "medium"
        },
        {
            "endpoint": "remove-element",
            "method": "POST",
            "label": "删除一个元素",
            "description": "按元素 id 删除一个区块、栏或控件。删除前自动写入修订，可用 rollback 端点回滚。",
            "handler": "VisualEditorApi::removeElement",
            "permission": "visual_editor.edit",
            "params": ["id", "element", "lock_version"],
            "risk": "high"
        },
        {
            "endpoint": "publish-document",
            "method": "POST",
            "label": "发布或撤回可视化文档",
            "description": "把文档状态切到 published 或 draft。发布前会校验文档树合法且至少有一个控件。",
            "handler": "VisualEditorApi::publishDocument",
            "permission": "visual_editor.publish",
            "params": ["id", "status", "lock_version"],
            "risk": "high"
        },
        {
            "endpoint": "revisions",
            "method": "GET",
            "label": "列出文档修订",
            "description": "列出某个文档最近的修订（id、备注、作者、时间），用于挑一个回滚点。",
            "handler": "VisualEditorApi::listRevisions",
            "permission": "visual_editor.view",
            "params": ["id", "limit"],
            "risk": "low"
        },
        {
            "endpoint": "rollback-document",
            "method": "POST",
            "label": "回滚文档到某个修订",
            "description": "把文档树整体换回指定修订的内容。当前内容会先被写成一条新修订，因此回滚本身也可再回滚。",
            "handler": "VisualEditorApi::rollbackDocument",
            "permission": "visual_editor.edit",
            "params": ["id", "revision", "lock_version"],
            "risk": "high"
        },
        {
            "endpoint": "delete-document",
            "method": "DELETE",
            "label": "删除可视化文档",
            "description": "删除文档及其全部修订。已发布的文档必须先撤回才能删除，避免线上页面突然 404。",
            "handler": "VisualEditorApi::deleteDocument",
            "permission": "visual_editor.edit",
            "params": ["id", "lock_version"],
            "risk": "high"
        }
    ]
}
