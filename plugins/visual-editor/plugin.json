{
    "slug": "visual-editor",
    "name": "可视化编辑器",
    "version": "1.3.2",
    "author": "odi0011",
    "author_url": "",
    "homepage": "",
    "description": "给内容编辑器加一颗独立的「可视化」入口：点开后整页渐隐出蒙版与加载动画，进入全屏拖拽编辑台，用「区块 / 栏 / 控件」搭页面，样式按桌面 / 平板 / 手机三档断点分别设置。控件参考 Elementor：标题、正文、图片、按钮、列表、引用、分隔线、间距、视频、图标、图标框、图文框、提示条、进度条与自定义 HTML。编辑树与首次接管前的原文另存在插件目录，核心内容字段里只写渲染好的 HTML 与作用域 CSS——插件停用或卸载后页面照常渲染，原文随时可一键还原。",
    "icon": "icon.svg",
    "screenshots": [],
    "requires": "7i",
    "requires_php": "8.0",
    "license": "MIT",
    "category": "content",
    "tags": ["可视化编辑", "页面搭建", "拖拽", "响应式"],
    "permissions": [
        {"key": "visual_editor.view", "label": "查看可视化托管状态", "group": "plugin", "sort_order": 1300},
        {"key": "visual_editor.edit", "label": "使用可视化编辑器", "group": "plugin", "sort_order": 1310},
        {"key": "visual_editor.code", "label": "使用自定义 HTML 控件", "group": "plugin", "sort_order": 1330}
    ],
    "settings": {
        "permission": "visual_editor.edit",
        "title": "可视化编辑器设置",
        "sections": [
            {
                "key": "layout",
                "label": "断点与宽度",
                "fields": [
                    {
                        "key": "breakpoint_tablet",
                        "label": "平板断点（px）",
                        "type": "number",
                        "default": 1024,
                        "min": 768,
                        "max": 1600,
                        "help": "视口宽度小于等于该值时套用平板样式。"
                    },
                    {
                        "key": "breakpoint_mobile",
                        "label": "手机断点（px）",
                        "type": "number",
                        "default": 767,
                        "min": 320,
                        "max": 1024,
                        "help": "视口宽度小于等于该值时套用手机样式。必须小于平板断点，否则渲染时按默认值兜底。"
                    },
                    {
                        "key": "container_max",
                        "label": "内容区最大宽度（px）",
                        "type": "number",
                        "default": 1200,
                        "min": 600,
                        "max": 2400,
                        "help": "定宽区块的内容最大宽度；通栏区块不受它约束。"
                    }
                ]
            }
        ]
    },
    "api": [
        {
            "endpoint": "visual-content",
            "method": "GET",
            "label": "列出可视化托管的内容",
            "description": "按源类型（page/article/product 或自定义内容类型 slug）分页列出正在被可视化编辑器托管的内容条目：id、标题、slug、区块与控件数量、是否失配。",
            "handler": "VisualEditorApi::listManaged",
            "permission": "visual_editor.view",
            "params": ["source_type", "page", "per_page"],
            "risk": "low"
        },
        {
            "endpoint": "document-state",
            "method": "GET",
            "label": "读取一个条目的可视化托管摘要",
            "description": "返回某个内容条目当前是否由可视化编辑器托管、是否在可视化之外被修改过（失配）、区块与控件计数和字节量。只读摘要，不含文档树本身。",
            "handler": "VisualEditorApi::state",
            "permission": "visual_editor.view",
            "params": ["source_type", "source_id"],
            "risk": "low"
        }
    ]
}
