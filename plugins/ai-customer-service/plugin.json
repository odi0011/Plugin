                        "label": "客服消息文字颜色",
                        "type": "color",
                        "default": "#111827"
                    },
                    {
                        "key": "visitor_bubble_color",
                        "label": "访客消息气泡底色",
                        "type": "color",
                        "default": "#4F46E5"
                    },
                    {
                        "key": "visitor_bubble_text_color",
                        "label": "访客消息文字颜色",
                        "type": "color",
                        "default": "#FFFFFF"
                    },
                    {
                        "key": "avatar_url",
                        "label": "客服头像或 Logo 地址",
                        "type": "url",
                        "default": "",
                        "max_length": 2048
                    },
                    {
                        "key": "show_avatar",
                        "label": "显示客服头像",
                        "type": "boolean",
                        "default": true
                    },
                    {
                        "key": "show_powered_by",
                        "label": "显示 AI 客服标识",
                        "type": "boolean",
                        "default": false
                    }
                ]
            },
            {
                "key": "ai",
                "label": "AI 与模型",
                "description": "模型来源与「描述词」。这里只写客服该怎么说话；它该知道什么放到“知识与资料”页。",
                "fields": [
                    {
                        "key": "provider_mode",
                        "label": "模型来源",
                        "type": "select",
                        "default": "system",
                        "options": [
                            {
                                "value": "system",
                                "label": "使用系统 AI 配置"
                            },
                            {
                                "value": "custom",
                                "label": "使用插件独立接口"
                            }
                        ]
                    },
                    {
                        "key": "system_model_id",
                        "label": "系统对话模型 ID",
                        "type": "number",
                        "default": 0,
                        "min": 0,
                        "max": 99999999,
                        "step": 1,
                        "help": "填 0 时使用系统“对话”默认模型。"
                    },
                    {
                        "key": "custom_api_endpoint",
                        "label": "独立接口地址",
                        "type": "url",
                        "default": "https://api.openai.com/v1/chat/completions",
                        "max_length": 2048,
                        "help": "仅支持公网 HTTPS 的 OpenAI Chat Completions 兼容地址。"
                    },
                    {
                        "key": "custom_model",
                        "label": "独立接口模型名称",
                        "type": "text",
                        "default": "",
                        "max_length": 160,
                        "placeholder": "例如：gpt-4.1-mini"
                    },
                    {
                        "key": "system_prompt",
                        "label": "描述词（角色与说话方式）",
                        "type": "textarea",
                        "default": "你是站点的前台客服。语气专业、友好、简洁；先给结论再给理由。资料里没写的一律不要编。",
                        "max_length": 6000,
                        "help": "只描述身份、语气、回答结构与流程，不要在这里堆产品资料——资料放到“知识与资料”页。"
                    },
                    {
                        "key": "temperature",
                        "label": "回复随机性",
                        "type": "number",
                        "default": 0.3,
                        "min": 0,
                        "max": 2,
                        "step": 0.1
                    },
                    {
                        "key": "max_tokens",
                        "label": "单次回复最大 Token 数",
                        "type": "number",
                        "default": 800,
                        "min": 128,
                        "max": 4096,
                        "step": 1
                    }
                ]
            },
            {
                "key": "knowledge",
                "label": "知识与资料",
                "description": "客服能引用的事实来源：站内已有内容、上传的知识库文件，以及手工补充的文本。与描述词分开管理。",
                "fields": [
                    {
                        "key": "knowledge_mode",
                        "label": "资料来源",
                        "type": "select",
                        "default": "both",
                        "options": [
                            {
                                "value": "off",
                                "label": "不使用资料（只按描述词回答）"
                            },
                            {
                                "value": "sources",
                                "label": "站内内容 + 手工补充"
                            },
                            {
                                "value": "files",
                                "label": "上传文件 + 手工补充"
                            },
                            {
                                "value": "both",
                                "label": "全部来源（站内内容 + 上传文件 + 手工补充）"
                            }
                        ],
                        "help": "「手工补充资料」只要非空就一直参与，除非选“不使用资料”。"
                    },
                    {
                        "key": "knowledge_json",
                        "label": "资料清单",
                        "type": "textarea",
                        "default": "{\"sources\":[],\"auto\":{\"products\":false,\"articles\":false,\"pages\":false,\"limit\":12},\"files\":[]}",
                        "max_length": 16000,
                        "help": "已选的站内内容与已上传的知识库文件；由上方资料柜写入，不要手改。"
                    },
                    {
                        "key": "knowledge_base",
                        "label": "手工补充资料",
                        "type": "textarea",
                        "default": "",
                        "max_length": 8000,
                        "placeholder": "可粘贴报价规则、服务流程、常见问答等短资料。",
                        "help": "当作一直带着的小抄：每次提问都优先注入，但最多占用注入额度的四成，剩下的留给按相关度挑出的片段。"
                    },
                    {
                        "key": "knowledge_budget",
                        "label": "单次注入资料上限（字）",
                        "type": "number",
                        "default": 4000,
                        "min": 500,
                        "max": 12000,
                        "step": 100,
                        "help": "按与访客问题的相关度挑选片段，直到用满这个额度。"
                    },
                    {
                        "key": "knowledge_strategy",
                        "label": "片段挑选方式",
                        "type": "select",
                        "default": "relevance",
                        "options": [
                            {
                                "value": "relevance",
                                "label": "按相关度（推荐）"
                            },
                            {
                                "value": "order",
                                "label": "按清单顺序"
                            }
                        ]
                    }
                ]
            },
            {
                "key": "tools",
                "label": "工具与卡片",
                "description": "让客服能\"做事\"：查站内内容并回一张可点击的卡片、拉起询盘表单、转人工、递名片。工具可自定义。",
                "fields": [
                    {
                        "key": "tools_enabled",
                        "label": "启用工具调用",
                        "type": "boolean",
                        "default": true,
                        "help": "关闭后客服只会用文字回答，不再返回任何卡片。"
                    },
                    {
                        "key": "tools_json",
                        "label": "工具清单",
                        "type": "textarea",
                        "default": "{\"builtin\":{\"recommend_products\":true,\"recommend_articles\":true,\"search_site\":true,\"lookup_knowledge\":true,\"show_inquiry_form\":true,\"request_handoff\":true,\"show_owner_card\":false,\"show_social_links\":false},\"custom\":[]}",
                        "max_length": 8000,
                        "help": "内置工具开关与自定义工具定义；由上方工具面板写入。"
                    },
                    {
                        "key": "tool_max_rounds",
                        "label": "单次提问最多工具轮次",
                        "type": "number",
                        "default": 2,
                        "min": 1,
                        "max": 3,
                        "step": 1,
                        "help": "一轮 = 模型调一次工具再据结果续写。轮次越多越慢越贵。"
                    },
                    {
                        "key": "cards_json",
                        "label": "卡片样式",
                        "type": "textarea",
                        "default": "{\"product\":{\"preset\":\"stack\",\"show_price\":true,\"show_summary\":true,\"cta\":\"查看详情\",\"max\":3},\"article\":{\"preset\":\"minimal\",\"cta\":\"阅读全文\",\"max\":3},\"owner\":{\"preset\":\"doodle\"},\"inquiry\":{\"preset\":\"panel\",\"fields\":[\"name\",\"email\",\"phone\",\"message\"],\"submit\":\"提交询盘\",\"success\":\"已收到，我们会尽快联系您。\"},\"social\":{\"preset\":\"chips\"}}",
                        "max_length": 8000,
                        "help": "产品卡、文章卡、名片、询盘卡、社媒卡各自的预设与文案。"
                    },
                    {
                        "key": "owner_json",
                        "label": "站长名片资料",
                        "type": "textarea",
                        "default": "{\"name\":\"\",\"title\":\"\",\"avatar\":\"\",\"bio\":\"\",\"socials\":[]}",
                        "max_length": 4000,
                        "help": "名片与社媒卡片的数据源：姓名、头衔、头像、简介与社媒链接。"
                    }
                ]
            },
            {
                "key": "guardrails",
                "label": "边界与事件",
                "description": "能聊什么、不能聊什么、越界怎么回；以及询盘转化与转人工这类自然语言意图的识别动作。",
                "fields": [
                    {
                        "key": "scope_mode",
                        "label": "话题范围",
                        "type": "select",
                        "default": "open",
                        "options": [
                            {
                                "value": "open",
                                "label": "开放（除禁止项外都可聊）"
                            },
                            {
                                "value": "restricted",
                                "label": "收敛（只聊允许清单里的话题）"
                            }
                        ]
                    },
                    {
                        "key": "guardrails_json",
                        "label": "约束清单",
                        "type": "textarea",
                        "default": "{\"allow_topics\":[],\"deny_topics\":[],\"must_do\":[],\"never_do\":[\"不要承诺交期、折扣或任何未在资料中写明的条件\"],\"blocked_words\":[],\"max_reply_chars\":1200,\"language\":\"auto\"}",
                        "max_length": 6000,
                        "help": "允许/禁止话题、必须做/绝不做、屏蔽词与回复长度上限；由上方约束面板写入。"
                    },
                    {
                        "key": "refusal_message",
                        "label": "越界时的回复",
                        "type": "textarea",
                        "default": "这个问题超出了我能回答的范围，我帮您转人工客服好吗？",
                        "max_length": 500
                    },
                    {
                        "key": "events_json",
                        "label": "意图事件",
                        "type": "textarea",
                        "default": "{\"inquiry\":{\"enabled\":true,\"keywords\":[\"报价\",\"价格\",\"多少钱\",\"采购\",\"下单\",\"询盘\",\"quote\",\"price\"],\"message\":\"我帮您留个联系方式，销售会尽快回复。\"},\"handoff\":{\"enabled\":true,\"keywords\":[\"人工\",\"转人工\",\"真人\",\"投诉\",\"human\",\"agent\"],\"message\":\"正在为您转接人工客服。\"},\"social\":{\"enabled\":false,\"keywords\":[\"微信\",\"联系方式\",\"社交\",\"whatsapp\",\"wechat\"],\"message\":\"这是我们的联系方式。\"},\"owner\":{\"enabled\":false,\"keywords\":[\"站长\",\"负责人\",\"老板\",\"owner\"],\"message\":\"这是负责人的名片。\"}}",
                        "max_length": 6000,
                        "help": "询盘、转人工、社媒、名片四类意图的关键词与触发动作。"
                    },
                    {
                        "key": "event_log_enabled",
                        "label": "记录意图命中日志",
                        "type": "boolean",
                        "default": false,
                        "help": "命中询盘/转人工意图时写一条应用日志（不含访客原文），便于回溯转化。"
                    },
                    {
                        "key": "inquiry_notify_email",
                        "label": "询盘通知邮箱",
                        "type": "email",
                        "default": "",
                        "max_length": 190,
                        "help": "留空则只在会话里回执，不额外发信。"
                    }
                ]
            },
            {
                "key": "composer",
                "label": "输入与表情",
                "description": "输入框行为、字符限制、emoji 与自定义表情包。",
                "fields": [
                    {
                        "key": "message_max_chars",
                        "label": "单条消息字符上限",
                        "type": "number",
                        "default": 2000,
                        "min": 100,
                        "max": 4000,
                        "step": 1
                    },
                    {
                        "key": "send_on_enter",
                        "label": "回车直接发送",
                        "type": "boolean",
                        "default": true,
                        "help": "关闭后回车换行，需点发送按钮。Shift+Enter 始终换行。"
                    },
                    {
                        "key": "emoji_enabled",
                        "label": "启用 emoji 面板",
                        "type": "boolean",
                        "default": true
                    },
                    {
                        "key": "sticker_enabled",
                        "label": "启用自定义表情包",
                        "type": "boolean",
                        "default": false,
                        "help": "开启后输入框旁出现表情包按钮，内容来自下方上传的图片/GIF。"
                    },
                    {
                        "key": "stickers_json",
                        "label": "表情与表情包",
                        "type": "textarea",
                        "default": "{\"emoji\":true,\"emoji_set\":[\"😀\",\"😄\",\"😊\",\"🙂\",\"😉\",\"👍\",\"🙏\",\"🎉\",\"❤️\",\"🔥\",\"✨\",\"💡\",\"📦\",\"🚚\",\"💰\",\"📞\"],\"gif\":false,\"packs\":[]}",
                        "max_length": 12000,
                        "help": "emoji 列表与已上传的表情包；由上方表情面板写入。"
                    }
                ]
            }
        ]
    },
    "api": [
        {
            "endpoint": "status",
            "method": "GET",
            "label": "读取 AI 客服状态",
            "description": "读取 AI 客服是否启用、当前模型来源、资料规模、已启用工具与公开显示规则摘要；不返回描述词全文、资料正文、密钥或访客会话。",
            "handler": "AiCustomerServiceApi::status",
            "permission": "ai_customer_service.view",
            "params": [],
            "risk": "low"
        }
    ]
}
